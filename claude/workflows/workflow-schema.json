{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDLC Workflow Definition",
  "description": "Schema for SDLC workflow definitions — defines agent stages, dependencies, gates, model tiers, and cost estimation.",
  "type": "object",
  "required": ["name", "description", "stages"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique workflow name (kebab-case)",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the workflow"
    },
    "trigger_patterns": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Natural language patterns that trigger this workflow"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "agent", "model_tier"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique stage identifier"
          },
          "agent": {
            "type": "string",
            "description": "Agent role that executes this stage",
            "enum": [
              "product-manager", "solution-architect", "software-engineer",
              "frontend-engineer", "quality-engineer", "code-reviewer",
              "security-engineer", "platform-engineer", "data-scientist",
              "ai-ml-engineer", "technical-writer", "research-advisor",
              "dotnet-engineer", "devops-sre"
            ]
          },
          "model_tier": {
            "type": "string",
            "enum": ["fast", "standard", "premium"],
            "description": "Model tier for cost control"
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Stage IDs that must complete before this stage"
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type"],
              "properties": {
                "id": { "type": "string" },
                "type": {
                  "type": "string",
                  "enum": ["automatic", "manual"]
                },
                "condition": {
                  "type": "string",
                  "description": "Automatic gate condition expression"
                },
                "prompt": {
                  "type": "string",
                  "description": "Manual gate user-facing prompt"
                }
              }
            }
          },
          "outputs": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Glob patterns for expected outputs"
          },
          "timeout_minutes": {
            "type": "integer",
            "default": 15,
            "description": "Max minutes before stage timeout"
          }
        }
      }
    },
    "estimated_cost": {
      "type": "object",
      "description": "Cost estimates for each stage",
      "additionalProperties": {
        "type": "string",
        "description": "Cost range string like '$2.00-5.00'"
      }
    }
  }
}
